# Application name (for Docker containers)
NAME=name
PREFIX_NAME=prod

# PostgreSQL Database (Prisma)
POSTGRES_USER=user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=database
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ArangoDB Database (Graph)
ARANGO_PORT=8529
ARANGO_URL="http://arangodb:8529"
ARANGO_DB="_system"
ARANGO_USER="root"
ARANGO_PASSWORD="arangodb_password"

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# JWT Authentication
JWT_SECRET=jwt_secret_key
JWT_EXPIRES_IN=7d

# OAuth (nuxt-auth-utils)
# NUXT_SESSION_PASSWORD must be at least 32 characters (seals OAuth state/PKCE cookies)
NUXT_SESSION_PASSWORD=change_me_to_a_random_32+_char_string
# Discord: https://discord.com/developers/applications -> OAuth2
# Redirect: <APP_URL>/auth/discord
NUXT_OAUTH_DISCORD_CLIENT_ID=discord_client_id
NUXT_OAUTH_DISCORD_CLIENT_SECRET=discord_client_secret

# Email (Resend)
RESEND_API_KEY=resend_api_key
EMAIL_FROM=noreply@mail.fr
APP_URL=http://localhost:3000

# Default Admin Account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin_password

# hCaptcha (https://dashboard.hcaptcha.com/sites)
# The values below are hCaptcha's public test keys - they always pass
# verification. Replace with real keys for production.
HCAPTCHA_SITE_KEY=hcaptcha_site_key
HCAPTCHA_SECRET=hcaptcha_secret_key
