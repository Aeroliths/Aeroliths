# Application name (for Docker containers)
NAME=aeroliths
PREFIX_NAME=prod

# PostgreSQL Database (Prisma)
POSTGRES_USER=aeroliths_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=aeroliths
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public

# ArangoDB Database (Graph)
ARANGO_PORT=8529
ARANGO_URL="http://arangodb:8529"
ARANGO_DB="_system"
ARANGO_USER="root"
ARANGO_PASSWORD="your_arango_password_here"

# Discord Notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# JWT Authentication
JWT_SECRET=jwt_secret_key
JWT_EXPIRES_IN=7d

# Email (SMTP)
SMTP_HOST=mail.aeroliths.fr
SMTP_PORT=587
SMTP_USER=noreply@aeroliths.fr
SMTP_PASS=your_smtp_password_here
SMTP_FROM=noreply@aeroliths.fr
APP_URL=http://localhost:3000
