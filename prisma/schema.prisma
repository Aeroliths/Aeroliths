// Prisma schema file for PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  username       String   @unique
  locale                     String    @default("en")
  profilePicture             String?
  emailVerified              Boolean   @default(false)
  verificationToken          String?
  verificationTokenExpiresAt DateTime?
  resetToken                 String?
  resetTokenExpiresAt        DateTime?
  lastActiveAt               DateTime  @default(now())
  deletionRequestedAt        DateTime?
  // Set once, the first time the player receives the starter pool.
  starterPoolGrantedAt       DateTime?
  // Running total. Every increment is backed by a Match row.
  xp                         Int       @default(0)
  // Stored, never derived: a curve edit must not restate a player's history.
  level                      Int       @default(1)
  deletionReminderSent       Boolean   @default(false)
  warning6MonthsSent         Boolean   @default(false)
  warning2MonthsSent         Boolean   @default(false)
  warning1MonthSent          Boolean   @default(false)
  warning1WeekSent           Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  // Relations
  authentication Authentication?
  role           Role            @relation(fields: [roleId], references: [id])
  roleId         String
  collections    Collections[]
  matches        Match[]
  chests         UserChest[]
  deck           Deck?
  loginHistory   LoginHistory[]
  oauthAccounts  OAuthAccount[]
  reportsMade    UserReport[]    @relation("ReportsMade")
  reportsAgainst UserReport[]    @relation("ReportsAgainst")

  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String // "discord"
  providerAccountId String // unique id from the provider
  createdAt         DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model UserReport {
  id        String   @id @default(cuid())
  type      String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporterId       String
  reporter         User   @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId   String
  reportedUser     User   @relation("ReportsAgainst", fields: [reportedUserId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@map("user_reports")
}

model LoginHistory {
  id        String   @id @default(cuid())
  loggedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([loggedAt])
  @@index([userId, loggedAt])
  @@map("login_history")
}

model SiteVisit {
  id        String   @id @default(cuid())
  visitorId String
  userId    String?
  visitedAt DateTime @default(now())

  @@index([visitedAt])
  @@index([visitorId, visitedAt])
  @@map("site_visits")
}

model Authentication {
  id           String   @id @default(cuid())
  password     String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Foreign key to User
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("authentications")
}

model Lithos {
  id         String   @id @default(cuid())
  name       String   @unique
  sprite     String
  spikeLeft  Int
  spikeRight Int
  spikeUp    Int
  spikeDown  Int
  rarity     String
  // Lithos handed out to every player through the starter pool.
  // starterQuantity is only read when isStarter is true.
  isStarter       Boolean @default(false)
  starterQuantity Int     @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  collections  Collections[]
  deckEntries  DeckEntry[]
  levelRewards LevelReward[]
  lootEntries  LootEntry[]
  element     Elements?   @relation(fields: [elementId], references: [id])
  elementId   String?

  @@map("lithos")
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  // Relations
  users User[]

  @@map("roles")
}

model Collections {
  id        String   @id @default(cuid())
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lithosId String
  lithos   Lithos @relation(fields: [lithosId], references: [id], onDelete: Cascade)

  // A user can only have one entry per Lithos
  @@unique([userId, lithosId])
  @@map("collections")
}

model Match {
  id            String   @id @default(cuid())
  // "bot" today; the online mode will add its own kind.
  opponent      String
  // Declared by the client and unverifiable by design: it only scales XP.
  difficulty    String
  boardSize     Int
  // Seen from the submitting player: "win" | "loss" | "draw".
  result        String
  scoreSelf     Int
  scoreOpponent Int
  xpAwarded     Int
  playedAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@map("matches")
}

model ProgressionLevel {
  id String @id @default(cuid())
  // Level 1 exists with a threshold of 0, so a fresh account is level 1.
  level      Int @unique
  xpRequired Int

  @@map("progression_levels")
}

model LevelReward {
  id String @id @default(cuid())
  // Level this tier pays out at. Not a relation: the curve can be replaced
  // wholesale without cascading away the rewards attached to it.
  level Int @unique
  // "lithos" today; the chest sub-lot adds its own kind.
  kind     String @default("lithos")
  quantity Int    @default(1)

  lithosId String?
  lithos   Lithos? @relation(fields: [lithosId], references: [id], onDelete: SetNull)

  chestTypeId String?
  chestType   ChestType? @relation(fields: [chestTypeId], references: [id], onDelete: Restrict)

  @@map("level_rewards")
}

model ChestType {
  id   String @id @default(cuid())
  name String @unique

  lootEntries  LootEntry[]
  userChests   UserChest[]
  levelRewards LevelReward[]

  @@map("chest_types")
}

model LootEntry {
  id String @id @default(cuid())
  // Relative weight, not a percentage: adding a line must not force a rebalance
  // of every other one.
  weight Int @default(1)

  chestTypeId String
  chestType   ChestType @relation(fields: [chestTypeId], references: [id], onDelete: Cascade)
  lithosId    String
  lithos      Lithos    @relation(fields: [lithosId], references: [id], onDelete: Cascade)

  @@unique([chestTypeId, lithosId])
  @@map("loot_entries")
}

model UserChest {
  id       String @id @default(cuid())
  quantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: deleting a type must never quietly take chests out
  // of players' hands.
  chestTypeId String
  chestType   ChestType @relation(fields: [chestTypeId], references: [id], onDelete: Restrict)

  @@unique([userId, chestTypeId])
  @@map("user_chests")
}

model Elements {
  id        String   @id @default(cuid())
  name      String   @unique
  sprite    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  lithos            Lithos[]
  weaknessesFrom    WeaknessElements[] @relation("ElementWeaknesses")
  weaknessesAgainst WeaknessElements[] @relation("WeakAgainstElement")
  strengthsFrom     StrengthElements[] @relation("ElementStrengths")
  strengthsAgainst  StrengthElements[] @relation("StrongAgainstElement")

  @@map("elements")
}

model MediaAsset {
  id        String   @id @default(cuid())
  category  String // "lithos" | "elements"
  path      String   @unique // "/app/uploads/lithos/lithos-123-abc.png"
  label     String
  hash      String // SHA-256 of the file contents
  mimeType  String
  size      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Scoped per category: the two libraries are separate, so the same file may
  // legitimately exist in both and deduplication applies within one library.
  @@unique([category, hash])
  @@index([category, createdAt])
  @@map("media_assets")
}

model WeaknessElements {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  elementId     String
  element       Elements @relation("ElementWeaknesses", fields: [elementId], references: [id], onDelete: Cascade)
  weakAgainstId String
  weakAgainst   Elements @relation("WeakAgainstElement", fields: [weakAgainstId], references: [id], onDelete: Cascade)

  // An element can only have one weakness entry per other element
  @@unique([elementId, weakAgainstId])
  @@map("weakness_elements")
}

model StrengthElements {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign keys
  elementId       String
  element         Elements @relation("ElementStrengths", fields: [elementId], references: [id], onDelete: Cascade)
  strongAgainstId String
  strongAgainst   Elements @relation("StrongAgainstElement", fields: [strongAgainstId], references: [id], onDelete: Cascade)

  // An element can only have one strength entry per other element
  @@unique([elementId, strongAgainstId])
  @@map("strength_elements")
}

model Deck {
  id        String      @id @default(cuid())
  name      String      @default("My Deck")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId  String      @unique
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries DeckEntry[]

  @@map("decks")
}

model DeckEntry {
  id       String @id @default(cuid())
  quantity Int    @default(1)

  deckId   String
  deck     Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)
  lithosId String
  lithos   Lithos @relation(fields: [lithosId], references: [id], onDelete: Cascade)

  @@unique([deckId, lithosId])
  @@map("deck_entries")
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String
  locale      String    @default("en")
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([slug, locale], name: "slug_locale")
  @@index([published, publishedAt])
  @@map("news")
}
